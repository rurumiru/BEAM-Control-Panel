<Layouts.auth
  flash={@flash}
  title="Первоначальная настройка"
  subtitle="Создайте учётную запись администратора"
>
  <.form :let={f} for={@changeset} action={~p"/setup"} class="space-y-4">
    <.input field={f[:name]} type="text" label="Имя" placeholder="Иван Иванов" />
    <.input field={f[:email]} type="email" label="E-mail" required autocomplete="username" />
    <.input
      field={f[:password]}
      type="password"
      label="Пароль"
      required
      autocomplete="new-password"
      placeholder="минимум 12 символов"
    />
    <.input
      field={f[:password_confirmation]}
      type="password"
      label="Повторите пароль"
      required
      autocomplete="new-password"
    />

    <button class="btn btn-primary w-full" type="submit">
      Создать администратора
    </button>
  </.form>

  <p class="mt-4 text-xs text-base-content/50">
    Этот пользователь получит роль <span class="font-semibold">администратор</span>
    и полный доступ ко всем серверам и проектам.
  </p>
</Layouts.auth>
