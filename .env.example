# BEAM Control Panel — пример конфигурации окружения.
#
#   cp .env.example .env
#   mix beam_panel.gen.secrets --output .env     # допишет SECRET_KEY_BASE и CLOAK-ключ
#
# В продакшене этот файл читает systemd (EnvironmentFile) или docker compose.

# ---------------------------------------------------------------- база данных
DATABASE_URL=ecto://beam_panel:CHANGE_ME@localhost/beam_panel_prod
POOL_SIZE=10
# ECTO_IPV6=true

# для docker compose
POSTGRES_USER=beam_panel
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=beam_panel_prod

# -------------------------------------------------------------------- секреты
# openssl rand -base64 64
SECRET_KEY_BASE=CHANGE_ME

# openssl rand -base64 32 — шифрует SSH-ключи, cookie и ENV проектов.
# ПОТЕРЯ КЛЮЧА = потеря доступа к сохранённым секретам. Храните с бэкапами.
BEAM_PANEL_CLOAK_KEY=CHANGE_ME

# -------------------------------------------------------------------- веб-слой
PHX_SERVER=true
PHX_HOST=panel.example.com
PORT=4000
PANEL_PORT=4000

# ------------------------------------------------------------------ поведение
# сколько дней хранить метрики в PostgreSQL
BEAM_PANEL_METRIC_RETENTION_DAYS=14

# отключить фоновый опрос серверов (диагностика)
# BEAM_PANEL_DISABLE_COLLECTORS=1

# ------------------------------------------------------- первичный админ (seeds)
BEAM_PANEL_ADMIN_EMAIL=admin@example.com
BEAM_PANEL_ADMIN_PASSWORD=CHANGE_ME_LONG_PASSWORD

# ------------------------------------------------------------------------ почта
# используется каналом уведомлений «email»
# SMTP_RELAY=smtp.example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_PORT=587
